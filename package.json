{
    "name": "expense-tracker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --turbopack",
        "ci-build": "prisma generate && next build --turbopack",
        "build": "prisma generate && prisma migrate deploy && next build --turbopack",
        "start": "prisma migrate deploy && next start",
        "lint": "eslint",
        "fix-formatting": "prettier --write ."
    },
    "dependencies": {
        "next": "16.4.0",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "packageManager": "pnpm@11.20.0"
}
