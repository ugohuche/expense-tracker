{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev",
      "type": "shell",
      "command": "pnpm install ; pnpm dev"
    },
    {
      "label": "Prisma Dev",
      "type": "shell",
      "command": "pnpm db:migrate:dev"
    },
    {
      "label": "Prisma Generate",
      "type": "shell",
      "command": "pnpm db:generate"
    },
    {
      "label": "Prisma Migrate",
      "type": "shell",
      "command": "pnpm db:migrate:deploy"
    },
    {
      "label": "Prisma Reset",
      "type": "shell",
      "command": "pnpm db:reset"
    },
    {
      "label": "Prisma Studio",
      "type": "shell",
      "command": "pnpm db:studio"
    },
    {
      "label": "PR - Tasks",
      "type": "shell",
      "command": "pnpm install ; pnpm fix-formatting ; pnpm lint ; pnpm build"
    },
    {
      "label": "PR - Tasks (Fix Formatting Only)",
      "type": "shell",
      "command": "pnpm fix-formatting"
    },
    {
      "label": "PR - Tasks (Lint Only)",
      "type": "shell",
      "command": "pnpm lint"
    },
    {
      "label": "PR - Tasks (Build Only)",
      "type": "shell",
      "command": "pnpm install ; pnpm build"
    }
  ]
}
