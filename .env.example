# allowPublicKeyRetrieval is required for local MySQL 8 users that authenticate
# with caching_sha2_password.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/expense_tracker?allowPublicKeyRetrieval=true"

# Used by NextAuth to sign/encrypt tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-secret"

# Required by NextAuth when the app is served from a custom host in production
# (self-hosted or preview deployments). Hosts are trusted automatically on Vercel.
AUTH_TRUST_HOST="true"
